{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.example/contracts/n8n/v1/response.schema.json",
  "title": "n8n to Jarvis turn response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "turn_id",
    "status",
    "spoken_text",
    "tool_results"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "session_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "turn_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,79}$"
    },
    "status": {
      "const": "complete"
    },
    "spoken_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "tool_results": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "status",
          "receipt_id"
        ],
        "properties": {
          "tool": {
            "const": "get_home_status"
          },
          "status": {
            "const": "succeeded"
          },
          "receipt_id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
          }
        }
      }
    }
  }
}
