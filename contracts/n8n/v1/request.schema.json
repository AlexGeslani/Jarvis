{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.example/contracts/n8n/v1/request.schema.json",
  "title": "Jarvis to n8n turn request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "turn_id",
    "transcript"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "session_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "turn_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,79}$"
    },
    "transcript": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  }
}
